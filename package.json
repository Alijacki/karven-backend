{
  "name": "karven-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker-entry.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "doctor": "node src/doctor.js",
    "legacy:scan": "node src/legacy-scan.js",
    "check": "node --check src/server.js && node --check src/worker.js && node --check src/routes/auth.js && node --check src/routes/workspaces.js && node --check src/routes/crm.js && node --check src/routes/platform.js && node --check src/doctor.js && node --check src/legacy-scan.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=22 <23" },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@fastify/cors": "10.0.0",
    "@fastify/helmet": "13.0.0",
    "@fastify/rate-limit": "10.0.0",
    "bullmq": "6.3.8",
    "fastify": "5.2.0",
    "ioredis": "5.4.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "pg": "8.13.1",
    "prom-client": "15.1.3",
    "zod": "3.24.1"
  }
}
