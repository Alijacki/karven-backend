NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://...
REDIS_URL=redis://...

KARVEN_JWT_SECRET=replace-with-at-least-32-random-characters
KARVEN_ADMIN_API_KEY=replace-with-at-least-32-random-characters
KARVEN_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
KARVEN_APP_URL=https://app.example.com
KARVEN_RUN_WORKER=true
KARVEN_METRICS_TOKEN=replace-with-random-token
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_MAX=300
PG_POOL_MAX=20

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KARVEN <no-reply@example.com>

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
